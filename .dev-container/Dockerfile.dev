# Official multi-platform Node 24.15.0 image; no downloaded shell installer.
FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates bash && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
USER node
# This development image does not own an app server; check runtime availability.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD node --version || exit 1
