{
  "extends": ["html-validate:recommended"],
  "rules": {
    "doctype-style": "off",
    "attr-delimiter": "error",
    "attr-spacing": "error",
    "attr-quotes": [
      "error",
      {
        "style": "double"
      }
    ],
    "void-style": "off",
    "no-trailing-whitespace": "error"
  }
}
