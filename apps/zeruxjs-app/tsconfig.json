{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.js",
    "*.ts",
    "*.js",
    "*.d.ts",
    "lib/**/*.ts",
    "client/**/*.ts",
    "plugins/**/*.ts",
    "scripts/**/*.ts"
  ]
}
