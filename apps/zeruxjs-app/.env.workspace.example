# Copy values into your private host environment. No service reads this example automatically.
WORKSPACE_ENABLED=true
WORKSPACE_ORIGIN=http://localhost:3010
WORKSPACE_TENANT=local
WORKSPACE_SITE=main
WORKSPACE_USERNAME=operator
# Operator-created @zeruxjs/auth scrypt hash. Never put a plaintext password here.
WORKSPACE_PASSWORD_HASH=
# Independently generated 32-byte base64url secret. Do not regenerate on every restart.
WORKSPACE_KEY=
# Required independently by auth password hashing in production.
SECURITY_PASSWORD_SALT=
# Legacy MySQL demo is opt-in. SQLite workspace does not need MySQL.
ENABLE_MYSQL_DEMO=false
