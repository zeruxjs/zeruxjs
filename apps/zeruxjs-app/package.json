{
  "name": "zeruxjs-app",
  "version": "1.0.0",
  "description": "Local ZeruxJS and ZyroJS integration workspace",
  "author": "Shubham Kumar Bansal",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@zeruxjs/accessibility": "0.0.4",
    "@zeruxjs/analytics": "0.0.4",
    "@zeruxjs/asset-manager": "0.0.4",
    "@zeruxjs/auth": "0.0.4",
    "@zeruxjs/cache": "0.0.4",
    "@zeruxjs/db": "0.0.4",
    "@zeruxjs/db-sqlite": "0.0.4",
    "@zeruxjs/email": "0.0.4",
    "@zeruxjs/feed": "0.0.4",
    "@zeruxjs/files": "0.0.4",
    "@zeruxjs/font": "0.0.4",
    "@zeruxjs/hooks": "0.0.4",
    "@zeruxjs/media": "0.0.4",
    "@zeruxjs/performance": "0.0.4",
    "@zeruxjs/react": "0.0.4",
    "@zeruxjs/reports": "0.0.4",
    "@zeruxjs/search": "0.0.4",
    "@zeruxjs/security": "0.0.4",
    "@zeruxjs/seo": "0.0.4",
    "@zeruxjs/share": "0.0.4",
    "@zeruxjs/tags": "0.0.4",
    "@zeruxjs/typescript": "0.0.4",
    "@zeruxjs/validator": "0.0.4",
    "@zeruxjs/vue": "0.0.4",
    "@zeruxjs/zyro": "0.0.4",
    "sample-child": "0.0.1",
    "sample-module": "0.0.1",
    "sample-os": "0.0.1",
    "sample-parent": "0.0.1",
    "zclivo": "0.0.4",
    "zeruxjs": "0.0.4",
    "zhost": "0.0.4",
    "zlocale": "0.0.4",
    "ztrial": "0.0.4",
    "zuixs": "0.0.4",
    "zyrojs": "0.0.4"
  },
  "private": true,
  "scripts": {
    "build": "zerux build",
    "dev": "zerux dev -p 3010",
    "start": "zerux start",
    "meow": "zerux meow",
    "ds:start": "SESSION=$(node -p \"require('./package.json').name.replace(/[@/]/g,'-')\") && tmux has-session -t \"$SESSION\" 2>/dev/null || tmux new-session -d -s \"$SESSION\" \"npm run start\"",
    "de:start": "SESSION=$(node -p \"require('./package.json').name.replace(/[@/]/g,'-')\") && tmux kill-session -t \"$SESSION\" 2>/dev/null || true",
    "ds:dev": "SESSION=$(node -p \"require('./package.json').name.replace(/[@/]/g,'-')\") && tmux has-session -t \"$SESSION\" 2>/dev/null || tmux new-session -d -s \"$SESSION\" \"npm run dev\"",
    "de:dev": "SESSION=$(node -p \"require('./package.json').name.replace(/[@/]/g,'-')\") && tmux kill-session -t \"$SESSION\" 2>/dev/null || true",
    "check:workspace": "tsc -p tsconfig.workspace.json",
    "test:workspace": "node --experimental-strip-types --test test/workspace.test.ts test/workspace-tools.test.ts",
    "workspace:init": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/workspace-init-cli.ts",
    "build:assets": "node --experimental-strip-types scripts/workspace-assets.ts",
    "prebuild": "npm run build:assets",
    "predev": "npm run build:assets",
    "check:browser": "node --experimental-strip-types scripts/workspace-browser-check.ts",
    "precheck:browser": "npm run build",
    "workspace:configure": "node --experimental-strip-types scripts/workspace-configure.ts",
    "watch:assets": "node --experimental-strip-types scripts/workspace-watch.ts",
    "check": "tsc -p tsconfig.json"
  },
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "types": "./dist/index.d.ts",
  "keywords": [
    "ZeruxJS Sample Application"
  ],
  "devDependencies": {
    "esbuild": "0.28.2",
    "zlook": "0.0.4"
  },
  "optionalDependencies": {
    "@zeruxjs/db-mysql": "0.0.4"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
