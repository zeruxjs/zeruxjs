{
  "name": "zeruxjs-docs",
  "version": "1.0.0",
  "description": "ZeruxJS Documentation",
  "author": "Shubham Kumar Bansal",
  "type": "module",
  "dependencies": {
    "@zeruxjs/security": "0.0.4",
    "@zeruxjs/typescript": "0.0.4",
    "zeruxjs": "0.0.4"
  },
  "private": true,
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "dev": "node --experimental-strip-types --watch scripts/serve.ts --dev",
    "preview": "node --experimental-strip-types scripts/serve.ts",
    "start": "node --experimental-strip-types scripts/serve.ts",
    "check": "node --experimental-strip-types scripts/check.ts",
    "snapshot": "node --experimental-strip-types scripts/snapshot.ts",
    "prebuild": "node --experimental-strip-types ../../scripts/build-workspaces.ts --scope zuixs --scope @zeruxjs/typescript --scope @zeruxjs/performance --scope @zeruxjs/search --scope @zeruxjs/security",
    "predev": "node --experimental-strip-types ../../scripts/build-workspaces.ts --scope zuixs --scope @zeruxjs/typescript --scope @zeruxjs/performance --scope @zeruxjs/search --scope @zeruxjs/security"
  },
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "keywords": [
    "ZeruxJS Documentation"
  ],
  "devDependencies": {
    "@zeruxjs/performance": "0.0.4",
    "@zeruxjs/search": "0.0.4",
    "marked": "^18.1.1",
    "zuixs": "0.0.4"
  }
}
