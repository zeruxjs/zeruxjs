{
  "name": "zerux-js-packages",
  "description": "ZeruxJS Packages",
  "private": true,
  "scripts": {
    "env:install": "node --experimental-strip-types ./scripts/install.ts",
    "env:stop": "node --experimental-strip-types ./scripts/stop.ts",
    "env:stop:hard": "node --experimental-strip-types ./scripts/stop.ts --hard",
    "env:dev": "node --experimental-strip-types ./scripts/dev.ts",
    "env:build": "node --experimental-strip-types ./scripts/build.ts",
    "env:start": "node --experimental-strip-types ./scripts/start.ts",
    "env:restart": "node --experimental-strip-types ./scripts/restart.ts",
    "env:list": "node --experimental-strip-types ./scripts/list.ts",
    "docker:shell": "docker exec -it zerux-dev-env bash",
    "docker:install": "docker exec -it zerux-dev-env npm run env:install",
    "docker:dev": "docker exec -d zerux-dev-env npm run env:dev",
    "docker:start": "docker exec -d zerux-dev-env npm run env:start",
    "docker:stop": "docker exec -it zerux-dev-env npm run env:stop",
    "docker:list": "docker exec -it zerux-dev-env npm run env:list",
    "docker:restart": "docker exec -it zerux-dev-env npm run env:restart",
    "docker:remove": "docker compose down -v --rmi all && rm -rf ./.dev-container/docker",
    "build:workspaces": "node --experimental-strip-types scripts/build-workspaces.ts --verify",
    "build:plan": "node --experimental-strip-types scripts/build-workspaces.ts --dry-run",
    "build:scope": "node --experimental-strip-types scripts/build-workspaces.ts",
    "test:workspace-tools": "node --experimental-strip-types --test scripts/*.test.ts",
    "test:frontend": "node --experimental-strip-types scripts/test-frontend.ts",
    "test:frontend:browser": "node --experimental-strip-types scripts/test-frontend.ts --browser",
    "test:analytics-sqlite": "node --experimental-strip-types --test tests/integration/analytics-sqlite.test.ts",
    "test:tags-sqlite": "node --experimental-strip-types --test tests/integration/tags-sqlite.test.ts",
    "test:reports-sqlite": "node --experimental-strip-types --test tests/integration/reports-sqlite.test.ts",
    "test:analytics-numeric-sqlite": "node --experimental-strip-types --test tests/integration/analytics-numeric-sqlite.test.ts",
    "test:analytics-reconciliation-sqlite": "node --experimental-strip-types --test tests/integration/analytics-reconciliation-sqlite.test.ts",
    "test:analytics-reconciliation-sql-compiler": "node --experimental-strip-types --test tests/integration/analytics-reconciliation-sql-compilation.test.ts",
    "test:analytics-job-sqlite": "node --experimental-strip-types --test tests/integration/analytics-job-sqlite.test.ts",
    "test:analytics-job-sql-compiler": "node --experimental-strip-types --test tests/integration/analytics-job-sql-compilation.test.ts",
    "test:queue": "node --experimental-strip-types --test packages/@zeruxjs/cache-redis/test/*.test.ts packages/@zeruxjs/queue/test/*.test.ts packages/zeruxjs/test/queue-runtime.test.ts",
    "deps:check": "node --experimental-strip-types scripts/check-workspace-deps.ts",
    "contracts:check": "node --experimental-strip-types scripts/check-workspace-contracts.ts",
    "deps:sync-local": "node --experimental-strip-types scripts/check-workspace-deps.ts --sync-local",
    "build:verified": "npm run deps:check && npm run contracts:check && npm run build:workspaces",
    "verify:clean": "node --experimental-strip-types scripts/verify-clean-workspace.ts",
    "verify:source": "node --experimental-strip-types scripts/verify-source-workspace.ts",
    "section66:finalize": "node --experimental-strip-types scripts/finalize-section66.ts",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "doctor:strict": "node --experimental-strip-types scripts/doctor.ts --strict",
    "test:developer": "node --experimental-strip-types scripts/test-developer.ts",
    "test:ecosystem": "node --experimental-strip-types scripts/test-ecosystem.ts",
    "test:ecosystem:offline": "node --experimental-strip-types scripts/test-ecosystem.ts --offline",
    "test:zyrojs": "node --experimental-strip-types scripts/test-zyrojs.ts",
    "test:zuix": "node --experimental-strip-types scripts/test-zuix.ts",
    "test:zuix:browser": "node --experimental-strip-types scripts/test-zuix-browser.ts",
    "lab:offline": "node --experimental-strip-types scripts/integration-lab.ts --offline --report=integration-lab/reports/offline.json",
    "lab:live": "node --experimental-strip-types scripts/integration-lab.ts --live --report=integration-lab/reports/live.json",
    "lab:all": "node --experimental-strip-types scripts/integration-lab.ts --all --report=integration-lab/reports/all.json",
    "lab:test": "node --experimental-strip-types --test scripts/integration-lab-core.test.ts",
    "api:freeze:check": "node --experimental-strip-types scripts/api-freeze.ts",
    "api:freeze:write": "node --experimental-strip-types scripts/api-freeze.ts --write --approve-breaking-review",
    "security:source": "node --experimental-strip-types scripts/security-audit.ts",
    "test:release-security": "node --experimental-strip-types --test scripts/workspace-api-freeze.test.ts scripts/workspace-security-audit.test.ts",
    "test:security:stress": "node --experimental-strip-types scripts/security-performance.ts",
    "test:section84": "npm run api:freeze:check && npm run security:source && npm run test:release-security && npm run test:security:stress",
    "license:inventory": "node --experimental-strip-types scripts/license-inventory.ts",
    "license:installed": "node --experimental-strip-types scripts/installed-license-review.ts --strict",
    "security:online": "npm audit --omit=dev --audit-level=high",
    "release:inventory": "node --experimental-strip-types scripts/package-release.ts --json",
    "release:pack": "node --experimental-strip-types scripts/package-release.ts --built --strict",
    "release:decision": "node --experimental-strip-types scripts/package-release.ts --json",
    "test:section85": "node --experimental-strip-types --test scripts/workspace-package-release.test.ts",
    "release:graph": "node --experimental-strip-types scripts/package-release-plan.ts",
    "release:foundation:consumer": "node --experimental-strip-types scripts/test-foundation-consumer.ts",
    "release:public:consumer": "node --experimental-strip-types scripts/public-package-consumer.ts",
    "release:ci:decision": "node --experimental-strip-types scripts/ci-release-decision.ts",
    "versions:check": "node --experimental-strip-types scripts/check-package-versions.ts",
    "test:versions": "node --experimental-strip-types --test scripts/workspace-version-policy.test.ts",
    "lint:prepare": "node --experimental-strip-types scripts/build-workspaces.ts --scope @zeruxjs/lint",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js": "eslint --config eslint.config.mjs .",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:js:report": "npm run lint:js -- --format json --output-file reports/eslint.json",
    "lint:css": "stylelint \"**/*.{css,scss}\" --config stylelint.config.mjs",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:css:report": "npm run lint:css -- --formatter json --output-file reports/stylelint.json",
    "lint:html": "html-validate --config htmlvalidate.config.json \"**/*.html\"",
    "lint:html:report": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\" && html-validate --config htmlvalidate.config.json --formatter json \"**/*.html\" > reports/htmlvalidate.json",
    "format:check": "prettier --config prettier.config.mjs --ignore-path .prettierignore --check",
    "format:write": "prettier --config prettier.config.mjs --ignore-path .prettierignore --write",
    "check:types:tests": "node --experimental-strip-types scripts/check-test-types.ts",
    "check:source-migration": "node --experimental-strip-types scripts/check-source-migration.ts",
    "quality:policy": "node --experimental-strip-types --test scripts/quality-policy.test.ts",
    "format:reviewed": "node --experimental-strip-types scripts/format-reviewed.ts"
  },
  "workspaces": [
    "packages/@zenixjs/*",
    "packages/@zeruxjs/*",
    "packages/*",
    "packages/create/*",
    "apps/*",
    "sample-packages/*"
  ],
  "devDependencies": {
    "@zeruxjs/lint": "0.0.4",
    "@zeruxjs/performance": "0.0.4",
    "@zeruxjs/typescript": "0.0.4",
    "better-sqlite3": "^12.6.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsdoc": "65.4.5",
    "globals": "17.5.0",
    "html-validate": "11.19.0",
    "postcss-media-query-parser": "file:vendor/zeruxjs-scss-media-parser-0.2.3.tgz",
    "postcss-scss": "4.0.9",
    "prettier": "3.8.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "zuixs": "0.0.4"
  },
  "releaseWorkspaces": [
    "packages/@zenixjs/*",
    "packages/@zeruxjs/*",
    "packages/*",
    "packages/create/*",
    "sample-packages/*"
  ],
  "overrides": {
    "braces": "npm:@zklogic/braces@3.0.7",
    "postcss-media-query-parser": "$postcss-media-query-parser",
    "minimatch@>=7 <11.0.1": "11.0.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
