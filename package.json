{
  "name": "zerux-js-packages",
  "description": "ZeruxJS Packages",
  "private": true,
  "scripts": {
    "env:install": "node ./scripts/install.js",
    "env:stop": "node ./scripts/stop.js",
    "env:stop:hard": "node ./scripts/stop.js --hard",
    "env:dev": "node ./scripts/dev.js",
    "env:build": "node ./scripts/build.js",
    "env:start": "node ./scripts/start.js",
    "env:restart": "node ./scripts/restart.js",
    "env:list": "node ./scripts/list.js",
    "docker:shell": "docker exec -it zerux-dev-env bash",
    "docker:install": "docker exec -it zerux-dev-env npm run env:install",
    "docker:dev": "docker exec -d zerux-dev-env npm run env:dev",
    "docker:start": "docker exec -d zerux-dev-env npm run env:start",
    "docker:stop": "docker exec -it zerux-dev-env npm run env:stop",
    "docker:list": "docker exec -it zerux-dev-env npm run env:list",
    "docker:restart": "docker exec -it zerux-dev-env npm run env:restart",
    "docker:remove": "docker compose down -v --rmi all && rm -rf ./.dev-container/docker",
    "build:workspaces": "node scripts/build-workspaces.mjs --verify",
    "build:plan": "node scripts/build-workspaces.mjs --dry-run",
    "build:scope": "node scripts/build-workspaces.mjs",
    "test:workspace-tools": "node --test scripts/*.test.mjs",
    "test:frontend": "node scripts/test-frontend.mjs",
    "test:frontend:browser": "node scripts/test-frontend.mjs --browser",
    "test:analytics-sqlite": "node --test tests/integration/analytics-sqlite.test.mjs",
    "test:tags-sqlite": "node --test tests/integration/tags-sqlite.test.mjs",
    "test:reports-sqlite": "node --test tests/integration/reports-sqlite.test.mjs",
    "test:analytics-numeric-sqlite": "node --test tests/integration/analytics-numeric-sqlite.test.mjs",
    "test:analytics-reconciliation-sqlite": "node --test tests/integration/analytics-reconciliation-sqlite.test.mjs",
    "test:analytics-reconciliation-sql-compiler": "node --test tests/integration/analytics-reconciliation-sql-compilation.test.mjs",
    "test:analytics-job-sqlite": "node --test tests/integration/analytics-job-sqlite.test.mjs",
    "test:analytics-job-sql-compiler": "node --test tests/integration/analytics-job-sql-compilation.test.mjs",
    "test:queue": "node --test packages/@zeruxjs/cache-redis/test/*.test.mjs packages/@zeruxjs/queue/test/*.test.mjs packages/zeruxjs/test/queue-runtime.test.mjs",
    "deps:check": "node scripts/check-workspace-deps.mjs",
    "contracts:check": "node scripts/check-workspace-contracts.mjs",
    "deps:sync-local": "node scripts/check-workspace-deps.mjs --sync-local",
    "build:verified": "npm run deps:check && npm run contracts:check && npm run build:workspaces",
    "verify:clean": "node scripts/verify-clean-workspace.mjs",
    "verify:source": "node scripts/verify-source-workspace.mjs",
    "section66:finalize": "node scripts/finalize-section66.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:strict": "node scripts/doctor.mjs --strict",
    "test:developer": "node scripts/test-developer.mjs",
    "test:ecosystem": "node scripts/test-ecosystem.mjs",
    "test:ecosystem:offline": "node scripts/test-ecosystem.mjs --offline",
    "test:zyrojs": "node scripts/test-zyrojs.mjs",
    "test:zuix": "node scripts/test-zuix.mjs",
    "test:zuix:browser": "node scripts/test-zuix-browser.mjs",
    "lab:offline": "node scripts/integration-lab.mjs --offline --report=integration-lab/reports/offline.json",
    "lab:live": "node scripts/integration-lab.mjs --live --report=integration-lab/reports/live.json",
    "lab:all": "node scripts/integration-lab.mjs --all --report=integration-lab/reports/all.json",
    "lab:test": "node --test scripts/integration-lab-core.test.mjs",
    "api:freeze:check": "node scripts/api-freeze.mjs",
    "api:freeze:write": "node scripts/api-freeze.mjs --write --approve-breaking-review",
    "security:source": "node scripts/security-audit.mjs",
    "test:release-security": "node --test scripts/workspace-api-freeze.test.mjs scripts/workspace-security-audit.test.mjs",
    "test:security:stress": "node scripts/security-performance.mjs",
    "test:section84": "npm run api:freeze:check && npm run security:source && npm run test:release-security && npm run test:security:stress",
    "license:inventory": "node scripts/license-inventory.mjs",
    "license:installed": "node scripts/installed-license-review.mjs --strict",
    "security:online": "npm audit --omit=dev --audit-level=high",
    "release:inventory": "node scripts/package-release.mjs --json",
    "release:pack": "node scripts/package-release.mjs --built --strict",
    "release:decision": "node scripts/package-release.mjs --json",
    "test:section85": "node --test scripts/workspace-package-release.test.mjs",
    "release:graph": "node scripts/package-release-plan.mjs",
    "release:foundation:consumer": "node scripts/test-foundation-consumer.mjs",
    "release:public:consumer": "node scripts/public-package-consumer.mjs",
    "release:ci:decision": "node scripts/ci-release-decision.mjs",
    "versions:check": "node scripts/check-package-versions.mjs",
    "test:versions": "node --test scripts/workspace-version-policy.test.mjs"
  },
  "workspaces": [
    "packages/@zenixjs/*",
    "packages/@zeruxjs/*",
    "packages/*",
    "packages/create/*",
    "apps/*"
  ],
  "devDependencies": {
    "better-sqlite3": "^12.6.2",
    "postcss-media-query-parser": "file:vendor/zeruxjs-scss-media-parser-0.2.3.tgz",
    "@zeruxjs/typescript": "0.0.3",
    "@zeruxjs/performance": "0.0.3",
    "zuixs": "0.0.3"
  },
  "releaseWorkspaces": [
    "packages/@zenixjs/*",
    "packages/@zeruxjs/*",
    "packages/*",
    "packages/create/*",
    "sample-packages/*"
  ],
  "overrides": {
    "braces": "npm:@zklogic/braces@3.0.7",
    "postcss-media-query-parser": "$postcss-media-query-parser"
  }
}
