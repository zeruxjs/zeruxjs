{
  "name": "@zenixjs/core",
  "version": "0.0.4",
  "description": "Minimal tenant-authorized CMS domain core with explicit SQLite persistence",
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build"
  },
  "keywords": [
    "cms",
    "zenix",
    "sqlite"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "examples/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cms": {
      "types": "./dist/cms.d.ts",
      "browser": null,
      "import": "./dist/cms.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "browser": null,
      "import": "./dist/types.js"
    }
  },
  "dependencies": {
    "@zeruxjs/auth": "0.0.4",
    "@zeruxjs/db": "0.0.4",
    "@zeruxjs/db-sqlite": "0.0.4",
    "@zeruxjs/files": "0.0.4"
  }
}
