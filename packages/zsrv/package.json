{
  "name": "zsrv",
  "version": "0.0.1",
  "description": "Server Creator and Handle Auto load and so via @zerux/watcher",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test test/*.test.mjs",
    "test:fleet": "npm run build && node --test test/fleet-*.test.mjs test/autoscale-policy.test.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocols": {
      "types": "./dist/protocols/index.d.ts",
      "import": "./dist/protocols/index.js"
    }
  },
  "license": "(MIT OR Apache-2.0)",
  "dependencies": {
    "chalk": "^4.1.2",
    "ws": "^8.22.0",
    "zforge": "0.0.1",
    "zlook": "0.0.1"
  },
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "keywords": [
    "Server Creator and Handle Auto load and so via @zerux/watcher"
  ],
  "bin": {
    "zerux-server": "./dist/bin/zerux.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^25.4.0"
  }
}
