{
  "name": "zenixjs",
  "version": "0.0.4",
  "description": "Initial ZyroJS-rendered CMS application for the ZeruxJS server",
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build"
  },
  "keywords": [
    "cms",
    "zenix",
    "zyrojs"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "examples/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./application": {
      "types": "./dist/application.d.mts",
      "browser": null,
      "import": "./dist/application.mjs"
    },
    "./setup-store": {
      "types": "./dist/setup-store.d.mts",
      "browser": null,
      "import": "./dist/setup-store.mjs"
    }
  },
  "dependencies": {
    "@zenixjs/core": "0.0.4",
    "@zeruxjs/accessibility": "0.0.4",
    "@zeruxjs/db-sqlite": "0.0.4",
    "@zeruxjs/security": "0.0.4",
    "@zeruxjs/validator": "0.0.4",
    "zeruxjs": "0.0.4",
    "zyrojs": "0.0.4"
  },
  "peerDependencies": {
    "@zeruxjs/asset-manager": "0.0.4"
  },
  "peerDependenciesMeta": {
    "@zeruxjs/asset-manager": {
      "optional": true
    }
  }
}
