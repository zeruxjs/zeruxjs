{
  "name": "zeruxjs",
  "version": "0.0.1",
  "description": "Main application ZeruxJS Framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zerux": "./dist/bin/zerux.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": "./dist/index.js",
    "./navigation": "./dist/navigation.js",
    "./accessibility": {
      "types": "./dist/accessibility.d.ts",
      "import": "./dist/accessibility.js"
    },
    "./cache": "./dist/cache-api.js",
    "./loader": "./dist/loader/register-loader.js",
    "./database": "./dist/bootstrap/database.js",
    "./cache-runtime": "./dist/bootstrap/cache.js",
    "./schema/schema.config.json": "./assets/json/schema.config.json",
    "./theme": "./dist/theme.js",
    "./protocols": "./dist/protocols.js",
    "./response": "./dist/response.js",
    "./fetch-route": "./dist/fetch-route.js",
    "./services": {
      "types": "./dist/bootstrap/services.d.ts",
      "import": "./dist/bootstrap/services.js"
    },
    "./build": {
      "types": "./dist/commands/project-builder.d.ts",
      "import": "./dist/commands/project-builder.js"
    },
    "./variables": {
      "types": "./dist/variables.d.ts",
      "import": "./dist/variables.js"
    }
  },
  "license": "(MIT OR Apache-2.0)",
  "dependencies": {
    "@zeruxjs/cache": "0.0.1",
    "@zeruxjs/db": "0.0.1",
    "@zeruxjs/lint": "0.0.1",
    "z-dev": "0.0.1",
    "@zeruxjs/hooks": "0.0.1",
    "zwatch": "0.0.1",
    "zsrv": "0.0.1",
    "zcli": "0.0.1"
  },
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "keywords": [
    "Main application ZeruxJS Framework"
  ],
  "peerDependencies": {
    "@zeruxjs/queue": "0.0.1"
  },
  "peerDependenciesMeta": {
    "@zeruxjs/queue": {
      "optional": true
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "assets/json/schema.config.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^25.4.0"
  }
}
