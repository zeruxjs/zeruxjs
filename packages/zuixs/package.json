{
  "name": "zuixs",
  "version": "0.0.4",
  "description": "Zero-dependency utility-first CSS compiler for ZeruxJS, ZyroJS, React, Vue, Next and Nuxt",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zuix": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test:smoke": "npm run build && node tests/smoke.mjs",
    "test": "npm run build && node --test tests/*.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./vite": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "license": "(MIT OR Apache-2.0)",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "css-tree": "3.2.1",
    "typescript": "^5.9.3",
    "zlook": "0.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "peerDependencies": {
    "source-map-js": "^1.2.2",
    "zlook": "0.0.4"
  },
  "peerDependenciesMeta": {
    "zlook": {
      "optional": true
    },
    "source-map-js": {
      "optional": true
    }
  }
}
