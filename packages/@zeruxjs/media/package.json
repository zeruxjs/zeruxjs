{
  "name": "@zeruxjs/media",
  "version": "0.0.4",
  "description": "Download and Upload Media, Making them enter only in non-executable area, Download Manager, expiry function and more.",
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "Download and Upload Media, Making them enter only in non-executable area, Download Manager, expiry function and more."
  ],
  "dependencies": {
    "@zeruxjs/files": "0.0.4"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@zeruxjs/accessibility": "0.0.4",
    "@zeruxjs/asset-manager": "0.0.4",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@zeruxjs/asset-manager": "0.0.4"
  },
  "peerDependenciesMeta": {
    "@zeruxjs/asset-manager": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    },
    "./resumable": {
      "types": "./dist/resumable.d.ts",
      "default": "./dist/resumable.js"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    },
    "./playback": {
      "types": "./dist/playback.d.mts",
      "import": "./dist/playback.mjs",
      "default": "./dist/playback.mjs"
    },
    "./transcode": {
      "types": "./dist/transcode.d.ts",
      "default": "./dist/transcode.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
