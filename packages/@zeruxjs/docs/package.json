{
  "name": "@zeruxjs/docs",
  "version": "0.0.4",
  "type": "module",
  "description": "Versioned documentation with reusable content, registered images, accessible rendering and explicit static/search adapters",
  "license": "(MIT OR Apache-2.0)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./zerux": {
      "types": "./dist/zerux.d.ts",
      "import": "./dist/zerux.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@zeruxjs/security": "0.0.4",
    "marked": "^18.2.0"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3",
    "zeruxjs": "0.0.4",
    "@zeruxjs/search": "0.0.4",
    "jsdom": "30.1.3",
    "@types/jsdom": "30.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "zeruxjs": "0.0.4",
    "@zeruxjs/search": "0.0.4"
  },
  "peerDependenciesMeta": {
    "zeruxjs": {
      "optional": true
    },
    "@zeruxjs/search": {
      "optional": true
    }
  }
}
