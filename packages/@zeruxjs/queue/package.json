{
  "name": "@zeruxjs/queue",
  "version": "0.0.4",
  "type": "module",
  "description": "BullMQ-backed queues and workers with ZeruxJS lifecycle management",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./neutral": {
      "types": "./dist/neutral.d.ts",
      "default": "./dist/neutral.js"
    },
    "./backends": {
      "types": "./dist/backends.d.ts",
      "default": "./dist/backends.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@zeruxjs/db": "0.0.4",
    "@zeruxjs/queue-bullmq": "0.0.4",
    "@zeruxjs/security": "0.0.4"
  },
  "license": "(MIT OR Apache-2.0)",
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@zeruxjs/db-sqlite": "0.0.4",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  }
}
