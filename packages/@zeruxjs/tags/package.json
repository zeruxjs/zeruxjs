{
  "name": "@zeruxjs/tags",
  "version": "0.0.4",
  "type": "module",
  "description": "Server and browser tag manager with versioned containers, triggers and destinations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin-client": {
      "types": "./dist/admin-client.d.ts",
      "default": "./dist/admin-client.js"
    },
    "./admin-view": {
      "types": "./dist/admin-view.d.ts",
      "default": "./dist/admin-view.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@zeruxjs/analytics": "0.0.4"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "(MIT OR Apache-2.0)",
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@zeruxjs/analytics": "0.0.4",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  }
}
