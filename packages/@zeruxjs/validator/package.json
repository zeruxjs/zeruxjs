{
  "name": "@zeruxjs/validator",
  "version": "0.0.1-alpha.2",
  "description": "Type-safe schema and HTTP input validation for ZeruxJS",
  "private": true,
  "author": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./http": {
      "types": "./dist/integrations/http.d.ts",
      "import": "./dist/integrations/http.js"
    }
  },
  "license": "(MIT OR Apache-2.0)",
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "keywords": [
    "Typescript Support"
  ]
}
