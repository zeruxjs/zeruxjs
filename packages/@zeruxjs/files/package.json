{
  "name": "@zeruxjs/files",
  "version": "0.0.1-alpha.2",
  "private": true,
  "description": "Multi-store filesystem, S3-compatible object storage and streaming Fetch file APIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/cloudfront-signer": "^3.900.0",
    "@aws-sdk/credential-providers": "^3.900.0",
    "@aws-sdk/lib-storage": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0"
  },
  "license": "(MIT OR Apache-2.0)"
}
