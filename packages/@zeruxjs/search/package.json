{
  "name": "@zeruxjs/search",
  "version": "0.0.4",
  "description": "Powerfull Search",
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "bench": "node --expose-gc bench/search.mjs"
  },
  "keywords": [
    "Powerfull Search"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./http": "./dist/http.js",
    "./persistence": "./dist/persistence.js",
    "./adapters": "./dist/adapters.js"
  },
  "files": [
    "dist/",
    "examples/",
    "bench/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^25.4.0"
  }
}
