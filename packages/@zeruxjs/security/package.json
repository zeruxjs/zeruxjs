{
  "name": "@zeruxjs/security",
  "version": "0.0.4",
  "description": "Context-specific encoding, Node crypto record policies, CSRF, CORS, cookies and security headers",
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./encoding": {
      "types": "./dist/encoding.d.ts",
      "import": "./dist/encoding.js"
    },
    "./crypto": {
      "types": "./dist/cryptography.d.ts",
      "import": "./dist/cryptography.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./jwt": {
      "types": "./dist/jwt-entry.d.ts",
      "import": "./dist/jwt-entry.js"
    }
  },
  "keywords": [
    "security",
    "csrf",
    "cors",
    "aes-gcm",
    "hmac",
    "output-encoding"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jose": "6.2.13"
  }
}
