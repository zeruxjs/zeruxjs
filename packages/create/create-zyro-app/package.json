{
  "name": "create-zyro-app",
  "version": "0.0.4",
  "description": "Safe standalone ZyroJS project generator with explicit rendering modes",
  "bin": {
    "create-zyro": "./dist/index.js",
    "create-zyro-app": "./dist/index.js"
  },
  "type": "module",
  "license": "(MIT OR Apache-2.0)",
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build"
  },
  "keywords": [
    "zyrojs",
    "generator",
    "hydration",
    "static"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "assets/",
    "examples/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    }
  },
  "dependencies": {
    "zclivo": "0.0.4"
  }
}
