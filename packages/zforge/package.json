{
  "name": "zforge",
  "version": "0.0.4",
  "description": "Dev tools present here like mapping function and classes and all internal services",
  "homepage": "https://github.com/zeruxjs/zeruxjs#readme",
  "bugs": {
    "url": "https://github.com/zeruxjs/zeruxjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "build:core": "tsc -p tsconfig.core.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./modules": {
      "types": "./dist/module-endpoints.d.ts",
      "import": "./dist/module-endpoints.js"
    },
    "./diagnostics": {
      "types": "./dist/request-diagnostics.d.ts",
      "import": "./dist/request-diagnostics.js"
    },
    "./experiments": {
      "types": "./dist/experiments.d.ts",
      "import": "./dist/experiments.js"
    }
  },
  "type": "module",
  "dependencies": {
    "@zeruxjs/security": "0.0.4"
  },
  "keywords": [
    "Dev tools present here like mapping function and classes and all internal services"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "assets/app.js",
    "assets/style.css",
    "assets/favicon.ico",
    "assets/favicon.png",
    "assets/robots.txt",
    "examples/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3",
    "ztrial": "0.0.4"
  },
  "peerDependencies": {
    "zeruxjs": "0.0.4",
    "zhost": "0.0.4",
    "ztrial": "0.0.4"
  },
  "peerDependenciesMeta": {
    "zhost": {
      "optional": true
    },
    "zeruxjs": {
      "optional": true
    },
    "ztrial": {
      "optional": true
    }
  },
  "workspaceBuild": {
    "bootstrapScript": "build:core",
    "finalizeDependencies": [
      "zhost",
      "zeruxjs"
    ]
  }
}
