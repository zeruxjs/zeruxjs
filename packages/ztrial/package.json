{
  "name": "ztrial",
  "version": "0.0.2",
  "description": "Modular testing framework and assertion toolkit for ZeruxJS, ZyroJS and JavaScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsdom": "./dist/adapters/jsdom/setup.js",
    "./playwright": "./dist/adapters/playwright/setup.js",
    "./vitest": "./dist/adapters/vitest/setup.js"
  },
  "license": "MIT",
  "bin": {
    "ztrial": "./dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^25.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  }
}
