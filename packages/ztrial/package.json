{
  "name": "ztrial",
  "version": "0.0.4",
  "description": "Modular testing framework and assertion toolkit for ZeruxJS, ZyroJS and JavaScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reports": {
      "types": "./dist/reports/index.d.ts",
      "import": "./dist/reports/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./jsdom": "./dist/adapters/jsdom/setup.js",
    "./playwright": {
      "types": "./dist/adapters/playwright/setup.d.ts",
      "import": "./dist/adapters/playwright/setup.js"
    },
    "./vitest": "./dist/adapters/vitest/setup.js",
    "./experiments": {
      "types": "./dist/experiments/index.d.ts",
      "import": "./dist/experiments/index.js"
    }
  },
  "license": "MIT",
  "bin": {
    "ztrial": "./dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "examples/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^25.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeruxjs/zeruxjs.git"
  }
}
